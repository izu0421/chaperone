data/
results/*.h5
results/*.cif
results/*.npz
logs/
msa/
folds/
*.sif
*.pt
__pycache__/
.ipynb_checkpoints/

# External code and containers: cloned/downloaded, not ours to vendor.
# RoseTTAFold2-PPI is GPL-3.0 from CongLabCode; SE3nv-20230612.sif is 14.4 GB.
ext/

# Fold outputs: 114 GB across 52,500 files in armB_out alone. The patterns above
# ("results/*.cif") only match directly inside results/, so the per-pair output
# directories escaped them entirely and a plain `git add -A` would have staged
# the lot. Exclude the output trees themselves, and keep the small score tables.
#
# Listing them one directory at a time does not hold: every new stage adds another
# tree and escapes the list silently. orphan_out (374 GB), huri_pilot_out (21 GB),
# noradrenaline_out and armA_msa (44 GB) were all untracked and unignored at once,
# so a plain `git add -A` would have tried to stage about 440 GB. Match the shape
# instead of the name.
results/*_out/
results/*_msa/
results/armD_example/
results/af3_pilot/out/
# work/ holds the AF3 input JSONs with embedded MSAs (GB-scale), but the
# manifests in it ARE the record of what was folded in each arm, 4 KB each.
# `work/` as a directory pattern would stop git descending at all, so a
# negation inside it could never match: exclude the CONTENTS and re-admit them.
work/*
!work/*manifest.csv
tmplog
